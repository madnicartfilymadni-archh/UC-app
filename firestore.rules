rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Products catalog - readable by all customers, manageable by admin
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders - readable for customer tracking & admin panel, creatable & updatable
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Payment Submissions (Manual receipts) - readable & manageable
    match /paymentSubmissions/{submissionId} {
      allow read, write: if true;
    }

    // Site Settings (General, Payment instructions)
    match /siteSettings/{settingId} {
      allow read, write: if true;
    }

    // Admin records
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Audit logs - write-once, immutable
    match /auditLogs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
  }
}
